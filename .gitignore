# Publish source by allowlist. Local images, outputs, credentials and runtimes stay local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/THIRD_PARTY.md
!/pyproject.toml
!/Comfy.ps1
!/Generate-3D.ps1
!/Dart3s.vbs
!/Details3D.vbs
!/comfy.yaml
!/dart3s/
!/Details3D/
!/docs/
!/tests/
!/scripts/
!/comfy_extensions/
!/workflows/
!/downloads/

/Details3D/state/
/scripts/*
!/scripts/*.py
!/scripts/*.pyw
!/scripts/*.ps1

/workflows/*
!/workflows/image-to-3d.recipe.json
!/workflows/image-to-3d.json
!/workflows/image-to-3d.parameters.json
/downloads/*
!/downloads/models.manifest.json
!/downloads/template.original.json

**/__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
*.pem
*.key
*.lnk
*.log
*.tmp
*.pre-dart3s
*.glb
*.gltf
*.safetensors
*.pt
*.pth
*.ckpt
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.7z
*.zip
*.whl
